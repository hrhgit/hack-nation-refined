# Copy to .env and fill in the key. Do not share or commit .env.
DEEPSEEK_API_KEY=your-deepseek-api-key
NAV_API_MODEL=deepseek-flash
NAV_API_BASE_URL=https://api.deepseek.com

# For another Chat Completions compatible service, use NAV_API_KEY instead,
# and replace NAV_API_MODEL / NAV_API_BASE_URL with that service's values.
